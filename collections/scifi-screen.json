      "tags": [
        "honesty",
        "mortality",
        "blunt"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-038",
      "content": "Klaatu barada nikto.",
      "authorName": "Klaatu (Michael Rennie)",
      "source": "The Day the Earth Stood Still (1951)",
      "sourceType": "movie",
      "quoteDate": "1951-09-28",
      "verificationStatus": "verified",
      "notes": "Command to stop Gort. Referenced in Army of Darkness and many other films.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
