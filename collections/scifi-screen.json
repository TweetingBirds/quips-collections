      "source": "The Matrix Resurrections (2021)",
      "sourceType": "movie",
      "quoteDate": "2021-12-22",
      "verificationStatus": "verified",
      "notes": "Bugs explaining how the Matrix weaponizes and trivializes important ideas by burying them in fiction.",
      "tags": [
        "truth",
        "technology",
        "questions"
      ],
      "addedAt": "2026-07-05T03:48:30Z"
    },
    {
