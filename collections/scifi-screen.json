      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-042",
      "content": "Never send a human to do a machine's job.",
      "authorName": "Agent Smith (Hugo Weaving)",
      "source": "The Matrix (1999)",
      "sourceType": "movie",
      "quoteDate": "1999-03-31",
      "verificationStatus": "verified",
