      "content": "Shiny. Let's be bad guys.",
      "authorName": "Jayne Cobb (Adam Baldwin)",
      "source": "Serenity (2005)",
      "sourceType": "movie",
      "quoteDate": "2005-09-30",
      "verificationStatus": "verified",
      "notes": "Jayne's enthusiastic agreement to a job. 'Shiny' became part of Firefly fan vocabulary.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
