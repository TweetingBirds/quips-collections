        "technology",
        "pride",
        "one-liner"
      ],
      "addedAt": "2026-07-05T03:48:30Z"
    },
    {
      "id": "scifi-043",
      "content": "Everything begins with choice.",
      "authorName": "Morpheus (Laurence Fishburne)",
      "source": "The Matrix Reloaded (2003)",
      "sourceType": "movie",
      "quoteDate": "2003-05-15",
      "verificationStatus": "verified",
