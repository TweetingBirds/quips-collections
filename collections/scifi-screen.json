  "quotes": [
    {
      "id": "scifi-001",
      "content": "May the Force be with you.",
      "authorName": "Obi-Wan Kenobi (Alec Guinness)",
      "source": "Star Wars: A New Hope (1977)",
      "sourceType": "movie",
      "quoteDate": "1977-05-25",
      "verificationStatus": "verified",
      "notes": "The franchise's signature blessing. First spoken by General Dodonna, but Obi-Wan made it iconic.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-002",
      "content": "Do. Or do not. There is no try.",
      "authorName": "Yoda (Frank Oz)",
      "source": "Star Wars: The Empire Strikes Back (1980)",
      "sourceType": "movie",
      "quoteDate": "1980-05-21",
      "verificationStatus": "verified",
      "notes": "Yoda's lesson to Luke about commitment. Frank Oz's puppetry brought the character to life.",
      "tags": [
        "effort",
        "choice",
        "aphorism"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-003",
      "content": "I am your father.",
      "authorName": "Darth Vader (James Earl Jones)",
      "source": "Star Wars: The Empire Strikes Back (1980)",
      "sourceType": "movie",
      "quoteDate": "1980-05-21",
      "verificationStatus": "verified",
      "notes": "Cinema's greatest twist. Often misquoted as 'Luke, I am your father.' Kept secret even from most cast.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-004",
      "content": "The Force will be with you. Always.",
      "authorName": "Obi-Wan Kenobi (Alec Guinness)",
      "source": "Star Wars: A New Hope (1977)",
      "sourceType": "movie",
      "quoteDate": "1977-05-25",
      "verificationStatus": "verified",
      "notes": "Obi-Wan's parting message to Luke before the Death Star assault. A promise fulfilled across the saga.",
      "tags": [
        "loyalty",
        "friendship",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-005",
      "content": "I've got a bad feeling about this.",
      "authorName": "Han Solo (Harrison Ford)",
      "source": "Star Wars: A New Hope (1977)",
      "sourceType": "movie",
      "quoteDate": "1977-05-25",
      "verificationStatus": "verified",
      "notes": "Running joke in the franchise. Every Star Wars film contains a variation of this line.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-006",
      "content": "Never tell me the odds.",
      "authorName": "Han Solo (Harrison Ford)",
      "source": "Star Wars: The Empire Strikes Back (1980)",
      "sourceType": "movie",
      "quoteDate": "1980-05-21",
      "verificationStatus": "verified",
      "notes": "Han dismissing C-3PO's probability calculations. Defines Han's reckless confidence.",
      "tags": [
        "risk",
        "defiance",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-007",
      "content": "This is the way.",
      "authorName": "The Mandalorian (Pedro Pascal)",
      "source": "The Mandalorian (2019)",
      "sourceType": "television",
      "quoteDate": "2019-11-12",
      "verificationStatus": "verified",
      "notes": "Mandalorian creed response. Became a cultural catchphrase from the Disney+ series.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-008",
      "content": "Live long and prosper.",
      "authorName": "Spock (Leonard Nimoy)",
      "source": "Star Trek (1966)",
      "sourceType": "television",
      "quoteDate": "1966-09-08",
      "verificationStatus": "verified",
      "notes": "Vulcan greeting with the split-finger salute. Nimoy based the gesture on a Jewish blessing.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-009",
      "content": "Space: the final frontier.",
      "authorName": "Captain Kirk (William Shatner)",
      "source": "Star Trek (1966)",
      "sourceType": "television",
      "quoteDate": "1966-09-08",
      "verificationStatus": "verified",
      "notes": "Opening narration of the original series. Became Trek's mission statement for 50+ years.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-010",
      "content": "Beam me up, Scotty.",
      "authorName": "Captain Kirk",
      "source": "Star Trek (attributed)",
      "sourceType": "television",
      "quoteDate": "c. 1960s",
      "verificationStatus": "unverified",
      "notes": "Never actually said in this exact form. A cultural condensation of various transport requests. Date reflects the original run of Star Trek (1966-1969), from which the phrase was condensed.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-011",
      "content": "The needs of the many outweigh the needs of the few.",
      "authorName": "Spock (Leonard Nimoy)",
      "source": "Star Trek II: The Wrath of Khan (1982)",
      "sourceType": "movie",
      "quoteDate": "1982-06-04",
      "verificationStatus": "verified",
      "notes": "Spock's logical justification for his sacrifice. Kirk later reverses it in Search for Spock.",
      "tags": [
        "sacrifice",
        "community",
        "aphorism"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-012",
      "content": "Resistance is futile.",
      "authorName": "The Borg",
      "source": "Star Trek: The Next Generation (1989)",
      "sourceType": "television",
      "quoteDate": "1989",
      "verificationStatus": "verified",
      "notes": "Borg collective's warning. First appeared in 'Q Who.' Became shorthand for overwhelming conformity.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-013",
      "content": "Make it so.",
      "authorName": "Captain Picard (Patrick Stewart)",
      "source": "Star Trek: The Next Generation (1987)",
      "sourceType": "television",
      "quoteDate": "1987-09-28",
      "verificationStatus": "verified",
      "notes": "Picard's command phrase. Stewart's Shakespearean delivery gave it gravitas.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-014",
      "content": "I'll be back.",
      "authorName": "The Terminator (Arnold Schwarzenegger)",
      "source": "The Terminator (1984)",
      "sourceType": "movie",
      "quoteDate": "1984-10-26",
      "verificationStatus": "verified",
      "notes": "Became Schwarzenegger's signature line. Used in many of his subsequent films.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-015",
      "content": "Come with me if you want to live.",
      "authorName": "Kyle Reese (Michael Biehn)",
      "source": "The Terminator (1984)",
      "sourceType": "movie",
      "quoteDate": "1984-10-26",
      "verificationStatus": "verified",
      "notes": "Kyle's first words to Sarah. Later said by different characters in sequels.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-016",
      "content": "I've seen things you people wouldn't believe.",
      "authorName": "Roy Batty (Rutger Hauer)",
      "source": "Blade Runner (1982)",
      "sourceType": "movie",
      "quoteDate": "1982-06-25",
      "verificationStatus": "verified",
      "notes": "Beginning of Roy's 'tears in rain' monologue. Hauer partly improvised the speech.",
      "tags": [
        "memory",
        "wonder",
        "lyrical"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-017",
      "content": "All those moments will be lost in time, like tears in rain.",
      "authorName": "Roy Batty (Rutger Hauer)",
      "source": "Blade Runner (1982)",
      "sourceType": "movie",
      "quoteDate": "1982-06-25",
      "verificationStatus": "verified",
      "notes": "Final line of Roy's death soliloquy. Hauer added 'like tears in rain' himself.",
      "tags": [
        "memory",
        "mortality",
        "impermanence",
        "lyrical"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-018",
      "content": "Fear is the mind-killer.",
      "authorName": "Paul Atreides (Timothee Chalamet)",
      "source": "Dune (2021)",
      "sourceType": "movie",
      "quoteDate": "2021-10-22",
      "verificationStatus": "verified",
      "notes": "From the Bene Gesserit Litany Against Fear. Originally from Frank Herbert's 1965 novel.",
      "tags": [
        "fear",
        "self-control",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-019",
      "content": "The spice must flow.",
      "authorName": "Baron Harkonnen",
      "source": "Dune (1984)",
      "sourceType": "movie",
      "quoteDate": "1984-12-14",
      "verificationStatus": "verified",
      "notes": "Emphasizes spice's economic importance. David Lynch's film version popularized this phrasing.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-020",
      "content": "He who controls the spice controls the universe.",
      "authorName": "Baron Harkonnen",
      "source": "Dune by Frank Herbert (1965)",
      "sourceType": "book",
      "quoteDate": "1965",
      "verificationStatus": "verified",
      "notes": "Encapsulates the novel's political themes. Spice as metaphor for oil is often discussed.",
      "tags": [
        "power",
        "money",
        "aphorism"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-021",
      "content": "In space, no one can hear you scream.",
      "authorName": "Tagline",
      "source": "Alien (1979)",
      "sourceType": "movie",
      "quoteDate": "1979-05-25",
      "verificationStatus": "verified",
      "notes": "Marketing tagline that became iconic. Captures the isolation horror of the film.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-022",
      "content": "Game over, man! Game over!",
      "authorName": "Private Hudson (Bill Paxton)",
      "source": "Aliens (1986)",
      "sourceType": "movie",
      "quoteDate": "1986-07-18",
      "verificationStatus": "verified",
      "notes": "Hudson's panicked outburst. Paxton's delivery made it quotable for generations.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-023",
      "content": "Get away from her, you bitch!",
      "authorName": "Ellen Ripley (Sigourney Weaver)",
      "source": "Aliens (1986)",
      "sourceType": "movie",
      "quoteDate": "1986-07-18",
      "verificationStatus": "verified",
      "notes": "Ripley protecting Newt from the Queen. One of cinema's great action hero moments.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-024",
      "content": "Welcome to the real world.",
      "authorName": "Morpheus (Laurence Fishburne)",
      "source": "The Matrix (1999)",
      "sourceType": "movie",
      "quoteDate": "1999-03-31",
      "verificationStatus": "verified",
      "notes": "Morpheus showing Neo the truth. The red pill/blue pill choice became cultural shorthand.",
      "tags": [
        "truth",
        "change",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-025",
      "content": "There is no spoon.",
      "authorName": "Spoon Boy",
      "source": "The Matrix (1999)",
      "sourceType": "movie",
      "quoteDate": "1999-03-31",
      "verificationStatus": "verified",
      "notes": "Lesson about bending reality. Represents understanding that the Matrix isn't real.",
      "tags": [
        "truth",
        "doubt",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-026",
      "content": "I know kung fu.",
      "authorName": "Neo (Keanu Reeves)",
      "source": "The Matrix (1999)",
      "sourceType": "movie",
      "quoteDate": "1999-03-31",
      "verificationStatus": "verified",
      "notes": "Neo after his first training upload. Reeves' amazed delivery became iconic.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-027",
      "content": "What is real? How do you define real?",
      "authorName": "Morpheus (Laurence Fishburne)",
      "source": "The Matrix (1999)",
      "sourceType": "movie",
      "quoteDate": "1999-03-31",
      "verificationStatus": "verified",
      "notes": "Morpheus questioning perception. Introduced philosophical concepts to mainstream audiences.",
      "tags": [
        "truth",
        "questions",
        "doubt"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-028",
      "content": "Roads? Where we're going, we don't need roads.",
      "authorName": "Doc Brown (Christopher Lloyd)",
      "source": "Back to the Future (1985)",
      "sourceType": "movie",
      "quoteDate": "1985-07-03",
      "verificationStatus": "verified",
      "notes": "Doc's closing line before the DeLorean flies. Sets up the sequel's promise.",
      "tags": [
        "travel",
        "change",
        "one-liner"
      ],
