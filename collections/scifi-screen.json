        "nature",
        "change",
        "one-liner"
      ],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-032",
      "content": "Clever girl.",
      "authorName": "Robert Muldoon (Bob Peck)",
      "source": "Jurassic Park (1993)",
      "sourceType": "movie",
      "quoteDate": "1993-06-11",
      "verificationStatus": "verified",
      "notes": "Muldoon's last words, realizing the raptor's trap. Perfect blend of respect and doom.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
      "id": "scifi-033",
      "content": "Hold onto your butts.",
      "authorName": "Ray Arnold (Samuel L. Jackson)",
      "source": "Jurassic Park (1993)",
      "sourceType": "movie",
      "quoteDate": "1993-06-11",
      "verificationStatus": "verified",
      "notes": "Arnold before rebooting the park systems. One of Jackson's most quotable lines.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
