      "authorName": "Doc Brown (Christopher Lloyd)",
      "source": "Back to the Future (1985)",
      "sourceType": "movie",
      "quoteDate": "1985-07-03",
      "verificationStatus": "verified",
      "notes": "Doc's exclamation of surprise. Lloyd's eccentric delivery defined the character.",
      "tags": [],
      "addedAt": "2026-06-27T20:29:50Z"
    },
    {
