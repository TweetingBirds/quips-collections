    {
      "id": "scifi-041",
      "content": "Soylent Green is people!",
      "authorName": "Detective Thorn (Charlton Heston)",
      "source": "Soylent Green (1973)",
      "sourceType": "movie",
      "quoteDate": "1973-04-06",
      "verificationStatus": "verified",
